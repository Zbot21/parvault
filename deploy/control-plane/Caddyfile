{$DOMAIN:localhost} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        -Server
    }

    # Strict 16 KiB payload ceiling on anonymous telemetry ingestion (DoS defense)
    handle /api/v1/telemetry* {
        request_body {
            max_size 16KB
        }
        reverse_proxy parvault-seed:9100
    }

    handle /api/census.json {
        request_body {
            max_size 16KB
        }
        reverse_proxy parvault-seed:9100
    }

    # Block external access to Grafana login/admin endpoints on public read-only dashboard
    @grafana_admin path /stats/login* /stats/api/admin* /stats/api/user*
    handle @grafana_admin {
        respond "Forbidden" 403
    }

    handle /stats* {
        request_body {
            max_size 16KB
        }
        reverse_proxy grafana:3000
    }

    handle {
        root * /srv/website
        file_server
    }
}
