#!/bin/sh /etc/rc.common
# /etc/init.d/parvault-nas — ParVault Router Cloud-NAS procd service
# START=95 starts after network, storage mounts (/mnt/nas), and firewall
# STOP=10

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/parvault
CONF=/etc/parvault/router.toml
# Must match data_dir in $CONF.
DATA=/mnt/nas/.parvault-data
SVC_USER=parvault
SVC_UID=4001

# First-run step: the service user and its data directory. The daemon writes its keys there on
# first start, as the service user (B-53).
init_service_user() {
    group_exists "$SVC_USER" || group_add "$SVC_USER" "$SVC_UID"
    user_exists "$SVC_USER" || user_add "$SVC_USER" "$SVC_UID" "$SVC_UID" "$SVC_USER" /var/empty
    [ -d "$DATA" ] || mkdir -p "$DATA"
    chown -R "$SVC_USER:$SVC_USER" "$DATA"
    chmod 0700 "$DATA"
}

start_service() {
    init_service_user
    # Refuse to start on a data directory the service user does not own (for example an old
    # root-owned one that chown could not change on a read-only mount).
    if [ "$(ls -ld "$DATA" | awk '{print $3}')" != "$SVC_USER" ]; then
        echo "parvault-nas: $DATA is not owned by $SVC_USER; refusing to start" >&2
        return 1
    fi

    procd_open_instance
    procd_set_param command "$PROG" up --profile router-soc --config "$CONF"
    procd_set_param user "$SVC_USER"

    # Respawn: threshold 3600 s, 5 s delay, 5 retries (procd needs all three values).
    procd_set_param respawn 3600 5 5
    # procd sends TERM to this instance on stop, then KILL after term_timeout seconds.
    procd_set_param term_timeout 10

    # No address-space (`as`) limit: it counts every thread's reserved stack and the mapped
    # binary, so a tokio daemon fails to start under it. Memory is bounded by the router runtime
    # (2 workers, 8 blocking threads; src/profile.rs). File descriptors: 1024.
    procd_set_param limits nofile=1024

    # Forward stdout and stderr to logd / syslog
    procd_set_param stdout 1
    procd_set_param stderr 1

    procd_close_instance
}
