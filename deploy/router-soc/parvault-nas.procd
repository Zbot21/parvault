#!/bin/sh /etc/rc.common
# /etc/init.d/parvault-nas — ParVault Router Cloud-NAS procd service
# START=95 starts after network, storage mounts (/mnt/nas), and firewall
# STOP=10

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/parvault
CONF=/etc/parvault/router.toml
# The NAS disk mountpoint; the data directory lives on it and must match data_dir in $CONF.
NAS=/mnt/nas
DATA=$NAS/.parvault-data
SVC_USER=parvault
SVC_UID=4001

fail() {
    logger -t parvault-nas -p daemon.err "$*"
    echo "parvault-nas: $*" >&2
    return 1
}

# The filesystem type mounted at $NAS, empty when nothing is mounted there.
nas_fstype() {
    awk -v m="$NAS" '$2 == m { t = $3 } END { print t }' /proc/mounts
}

owner_of() {
    ls -ld "$1" | awk '{print $3}'
}

# First-run step: the service user and its data directory, on the mounted NAS disk only. The
# daemon writes its keys there on first start, as the service user (B-53). Supported
# filesystems keep POSIX owners and modes: ext4, f2fs, btrfs, xfs. vfat, exfat and NTFS do not,
# so the service refuses them rather than run with keys it cannot protect.
init_service_user() {
    local fstype
    fstype="$(nas_fstype)"
    [ -n "$fstype" ] || { fail "$NAS is not a mountpoint; mount the NAS disk first"; return 1; }
    case "$fstype" in
        vfat|msdos|exfat|ntfs|ntfs3|fuseblk)
            fail "$NAS is $fstype, which has no POSIX owners; use ext4, f2fs, btrfs or xfs"
            return 1 ;;
    esac
    group_exists "$SVC_USER" || group_add "$SVC_USER" "$SVC_UID"
    user_exists "$SVC_USER" || user_add "$SVC_USER" "$SVC_UID" "$SVC_UID" "$SVC_USER" /var/empty
    [ -d "$DATA" ] || mkdir -m 0700 "$DATA" || { fail "cannot create $DATA"; return 1; }
    # Chown only when the owner differs: a new directory, or one a root-run release left
    # behind, whose contents move with it once. A started service never walks the store.
    if [ "$(owner_of "$DATA")" != "$SVC_USER" ]; then
        chown -R "$SVC_USER:$SVC_USER" "$DATA" || { fail "cannot chown $DATA"; return 1; }
    fi
    chmod 0700 "$DATA"
}

start_service() {
    init_service_user || return 1
    # Refuse to start on a data directory the service user does not own (for example one on a
    # read-only mount that chown could not change).
    if [ "$(owner_of "$DATA")" != "$SVC_USER" ]; then
        fail "$DATA is not owned by $SVC_USER; refusing to start"
        return 1
    fi

    procd_open_instance
    procd_set_param command "$PROG" up --profile router-soc --config "$CONF"
    procd_set_param user "$SVC_USER"

    # Respawn: threshold 3600 s, 5 s delay, 5 retries (procd needs all three values).
    procd_set_param respawn 3600 5 5
    # procd sends TERM to this instance on stop, then KILL after term_timeout seconds.
    procd_set_param term_timeout 10

    # No address-space (`as`) limit: it counts every thread's reserved stack and the mapped
    # binary, so a tokio daemon fails to start under it. The router runtime caps tokio's own
    # threads (2 workers, 8 blocking; src/profile.rs), but the daemon also runs std threads
    # outside it, so this is not a memory bound; see docs/metrics.txt for measured RSS.
    # File descriptors: 1024.
    procd_set_param limits nofile=1024

    # Forward stdout and stderr to logd / syslog
    procd_set_param stdout 1
    procd_set_param stderr 1

    procd_close_instance
}
